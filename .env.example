# ============================================================
# AI Revenue Recovery Engine — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================================

# ------------------------------------------------------------
# PRIMARY DATABASE: Neon PostgreSQL (hosted)
# ------------------------------------------------------------
# 1. Create a project at https://neon.tech
# 2. Copy your connection string from the Neon dashboard.
# 3. Paste it here (sslmode=require is required for Neon).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Model version tracking (optional — defaults to 'unversioned' if not set)
MODEL_VERSION=v1.0

# ------------------------------------------------------------
# OPTIONAL: Local Docker PostgreSQL development
# (Only required if running docker-compose up for local dev)
# The application connects via DATABASE_URL above, not these.
# ------------------------------------------------------------
POSTGRES_DB=recovery_db
POSTGRES_USER=recovery_app
POSTGRES_PASSWORD=your_secure_local_password_here
POSTGRES_PORT=5432

# ------------------------------------------------------------
# OPTIONAL: Dedicated test database (for integration tests only)
# Never use your production DATABASE_URL for TEST_DATABASE_URL.
# Integration tests are skipped if this variable is not set.
# ------------------------------------------------------------
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/TESTDBNAME?sslmode=require
